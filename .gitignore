# ============================================================
# KiriLock monorepo Git ignore
# Keep application source, configuration, lockfiles, tests,
# migrations, scripts, and documentation tracked.
# ============================================================

# ------------------------------------------------------------
# Node / npm
# ------------------------------------------------------------

node_modules/
.npm/
.npmrc.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------
# Build output
# ------------------------------------------------------------

dist/
build/
.vite/
.parcel-cache/
.turbo/
.cache/
.tmp/
temp/
*.tsbuildinfo

# ------------------------------------------------------------
# Test / coverage output
# ------------------------------------------------------------

coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/

# Playwright local browser cache/artifacts
playwright/.cache/

# ------------------------------------------------------------
# Environment / secrets
# ------------------------------------------------------------

.env
.env.*
!.env.example
!.env.sample
!.env.template

# Local credentials / tokens
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
credentials.json
secrets.json

# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------

*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------
# KiriLock generated phase backups
# These are recovery copies, not source.
# ------------------------------------------------------------

frontend/.phase-*-backup-*/
frontend/.phase-*-build-*.log

# Any phase artifacts accidentally created at repo root
.phase-*-backup-*/
.phase-*-build-*.log

# ------------------------------------------------------------
# Temporary patch / scratch files
# ------------------------------------------------------------

*.tmp
*.temp
*.bak
*.backup
*.orig
*.rej
*.swp
*.swo
*~

# Python / shell temporary artifacts
__pycache__/
*.pyc

# ------------------------------------------------------------
# IDE / editor
# ------------------------------------------------------------

.vscode/
.idea/
*.iml

# Keep shared editor configuration when explicitly committed.
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# ------------------------------------------------------------
# Operating system
# ------------------------------------------------------------

.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------
# Frontend tool caches
# ------------------------------------------------------------

.eslintcache
.stylelintcache
.tscache

# ------------------------------------------------------------
# Local development databases / browser state
# ------------------------------------------------------------

*.sqlite
*.sqlite3
*.db
.playwright/
.browser/
.browser-data/

# ------------------------------------------------------------
# Generated screenshots / recordings
# ------------------------------------------------------------

*.png
*.jpg
*.jpeg
*.webp
*.gif
*.webm

# NOTE:
# Visual assets that are intentionally part of the product should
# be force-added or placed under a dedicated tracked assets policy.
# Do NOT put source assets under ignored build/test directories.

# ------------------------------------------------------------
# OS-specific local files
# ------------------------------------------------------------

.DS_Store?
ehthumbs.db

# ------------------------------------------------------------
# Temporary frontend exports
# ------------------------------------------------------------

frontend/export/
frontend/tmp/
frontend/.tmp/

# ------------------------------------------------------------
# Local generated reports
# ------------------------------------------------------------

reports/
artifacts/
.local/

# ------------------------------------------------------------
# Local KiriLock recovery snapshots
# ------------------------------------------------------------

.gitignore.backup-*
frontend/.phase-*
.phase-*
