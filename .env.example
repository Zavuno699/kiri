# KiriLock Environment Configuration
# ==================================
# This is a template for environment variables.
# Copy this file to .env and fill in the actual values.
# NEVER commit .env with real credentials.

# Application
APP_ENV=development
APP_NAME=kirilock

# HTTP
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# Database (PostgreSQL)
# Canonical database URL used by all services
DATABASE_URL=postgresql://user:password@localhost:5432/kirilock

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092

# Security
# Secret for token signing (security-service)
SECURITY_TOKEN_SECRET=your-secret-key-here

# Service URLs
IDENTITY_SERVICE_URL=http://localhost:8081
SECURITY_SERVICE_URL=http://localhost:8080
DEVICE_SERVICE_URL=http://localhost:8082
BILLING_SERVICE_URL=http://localhost:8083

# Frontend
VITE_API_BASE_URL=http://localhost:8080
VITE_IDENTITY_SERVICE_URL=http://localhost:8081
VITE_APP_NAME=KiriLock

# Observability
LOG_LEVEL=info

# Development Environment
# ==================================
# Only used for development bootstrap and .env loading
# Set to "development" or "test" to enable .env file loading
# Production should NOT set this (relies on real env injection)
KIRI_ENV=development

# Development Account Credentials
# ==================================
# These are used by the dev-bootstrap command to provision test accounts
# Only used when KIRI_ENV=development or KIRI_ENV=test
# Replace with your actual development credentials

# Landlord test account
DEV_LANDLORD_EMAIL=landlord@example.com
DEV_LANDLORD_PASSWORD=your-landlord-password-here

# Super Admin test account
DEV_SUPERADMIN_EMAIL=superadmin@example.com
DEV_SUPERADMIN_PASSWORD=your-superadmin-password-here
