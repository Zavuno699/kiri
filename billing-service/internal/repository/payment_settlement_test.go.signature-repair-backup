func TestSettlePaymentRejectsAmountMismatchBeforeWrite(t *testing.T) {
	db, mock, err := sqlmock.New()
	if err != nil {
		t.Fatal(err)
	}
	defer db.Close()

	repo := NewPaymentRepository(db)

	err = repo.SettlePayment(
		context.Background(),
		"KIRI-5J-REF-003",
		"FLUTTERWAVE",
		"FW-CHARGE-5J-003",
		49999,
		"UGX",
		"FW-EVENT-5J-003",
		"payload-hash-5j-003",
	)

	if err == nil {
		t.Fatal("expected mismatch/not-found error")
	}

	if !errors.Is(err, ErrPaymentNotFound) &&
		!errors.Is(err, ErrPaymentMismatch) {
		t.Fatalf("unexpected error: %v", err)
	}

	if err := mock.ExpectationsWereMet(); err != nil {
		t.Fatalf("unexpected database interaction: %v", err)
	}
}

