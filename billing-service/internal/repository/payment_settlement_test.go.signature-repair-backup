		!errors.Is(err, ErrPaymentMismatch) {
		t.Fatalf("expected already-settled or mismatch error, got %v", err)
	}

	if err := mock.ExpectationsWereMet(); err != nil {
		t.Fatalf("database expectations were not met: %v", err)
