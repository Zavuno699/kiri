# Backend Environment Configuration
# ==================================
# This is a template for backend microservices environment variables.
# NEVER commit .env with real credentials.

# Database (PostgreSQL)
# Railway provides DATABASE_URL automatically for PostgreSQL services
# For local development, use: postgresql://user:password@localhost:5432/kirilock
DATABASE_URL=postgresql://user:password@localhost:5432/kirilock

# Service URLs (Railway Private Networking)
# For Railway deployment, use internal DNS form: http://<service-name>.railway.internal:<port>
# Example: IDENTITY_SERVICE_URL=http://identity-service.railway.internal:8081
IDENTITY_SERVICE_URL=http://localhost:8081
SECURITY_SERVICE_URL=http://localhost:8080
DEVICE_SERVICE_URL=http://localhost:8082
BILLING_SERVICE_URL=http://localhost:8083

# Security
SECURITY_TOKEN_SECRET=your-secret-key-here

# CORS
# Comma-separated list of allowed origins for frontend (e.g., https://yourdomain.com,https://www.yourdomain.com)
# Development defaults to * (all origins allowed)
CORS_ALLOWED_ORIGINS=*

# Payment Provider (Flutterwave)
# Required in production (billing-service fails closed without these)
# Dev/test environments can use DevTestProvider when KIRI_ENV=development|test
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v1
FLUTTERWAVE_CLIENT_ID=your-flutterwave-client-id
FLUTTERWAVE_CLIENT_SECRET=your-flutterwave-client-secret

# Development Environment
# Set to "development" or "test" to enable .env file loading
# Production should NOT set this (relies on real env injection)
KIRI_ENV=development

# Dev Bootstrap Credentials
# These are used by the dev-bootstrap command to provision test accounts
DEV_LANDLORD_EMAIL=landlord@example.com
DEV_LANDLORD_PASSWORD=your-landlord-password-here
DEV_SUPERADMIN_EMAIL=superadmin@example.com
DEV_SUPERADMIN_PASSWORD=your-superadmin-password-here
