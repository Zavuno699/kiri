# Development Account Credentials
# ==================================
# This file is a template for development account provisioning.
# Copy this file to dev-accounts.env and fill in the REAL credentials.
# NEVER commit dev-accounts.env with real passwords.

# Environment flag - MUST be set to "development" or "test" for dev-bootstrap to run
KIRI_ENV=development

# Database connection (same as used by identity-service)
DATABASE_URL=postgresql://user:password@localhost:5432/kirilock

# Landlord test account
DEV_LANDLORD_EMAIL=landlord@example.com
DEV_LANDLORD_PASSWORD=your_landlord_password_here

# Super Admin test account
DEV_SUPERADMIN_EMAIL=superadmin@example.com
DEV_SUPERADMIN_PASSWORD=your_superadmin_password_here
